<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data extraction rules. We opt out of cloud backup and
    device-to-device transfer for sensitive paths (settings, models).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
